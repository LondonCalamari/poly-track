# EdgeCopy v1 - Environment Variables
# Copy this file to .env and fill in your actual values

# API Keys (All Optional!)

# Polysights (optional - system includes mock data for testing)
POLYSIGHTS_API_KEY=your_polysights_api_key_here

# PolygonScan (FREE - get at https://polygonscan.com/apis)
# Highly recommended - enables real blockchain monitoring
POLYGONSCAN_API_KEY=your_free_polygonscan_api_key_here

# ========================================
# REMOVED - No longer needed!
# ========================================
# Nevua Markets - REPLACED by built-in BlockchainWalletScanner
# HashDive - REPLACED by built-in InternalReputationSystem
#
# The system now works WITHOUT these API keys!
# ========================================

# Polymarket/Polygon RPC
POLYGON_RPC_URL=https://polygon-rpc.com
POLYMARKET_API_URL=https://gamma-api.polymarket.com

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Webhook
WEBHOOK_URL=your_webhook_url

# Email Notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@gmail.com
EMAIL_PASSWORD=your_app_password

# Database (if using PostgreSQL instead of SQLite)
DATABASE_URL=sqlite:///./data/polytrack.db
# DATABASE_URL=postgresql://user:password@localhost:5432/polytrack

# Security
SECRET_KEY=your_random_secret_key_here

# Optional: Development Mode
DEBUG=false
ENVIRONMENT=production
