# EdgeCopy v1 - Environment Variables
# Copy this file to .env and fill in your actual values

# API Keys
POLYSIGHTS_API_KEY=your_polysights_api_key_here
NEVUA_MARKETS_API_KEY=your_nevua_api_key_here
HASH_DIVE_API_KEY=your_hashdive_api_key_here

# Polymarket/Polygon RPC
POLYGON_RPC_URL=https://polygon-rpc.com
POLYMARKET_API_URL=https://gamma-api.polymarket.com

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Webhook
WEBHOOK_URL=your_webhook_url

# Email Notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@gmail.com
EMAIL_PASSWORD=your_app_password

# Database (if using PostgreSQL instead of SQLite)
DATABASE_URL=sqlite:///./data/polytrack.db
# DATABASE_URL=postgresql://user:password@localhost:5432/polytrack

# Security
SECRET_KEY=your_random_secret_key_here

# Optional: Development Mode
DEBUG=false
ENVIRONMENT=production
